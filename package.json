{
  "name": "@getsupaflow/cli",
  "version": "0.9.0",
  "description": "Manage data pipelines, build custom Python connectors, and connect AI assistants to Supaflow with its CLI and MCP server.",
  "type": "module",
  "bin": {
    "supaflow": "bin/supaflow.mjs"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/ tests/",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "supaflow",
    "cli",
    "data-integration",
    "data-pipelines",
    "etl",
    "custom-connectors",
    "mcp",
    "mcp-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supaflow-labs/supaflow-cli.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "vitest": "^4.1.12",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.7"
    }
  },
  "homepage": "https://www.supa-flow.io/docs/cli",
  "bugs": {
    "url": "https://github.com/supaflow-labs/supaflow-cli/issues"
  },
  "author": {
    "name": "Supaflow",
    "email": "support@supa-flow.io"
  }
}
